# ─── analyze-meal Edge Function secrets ─────────────────────────────────────
# REAL values only — never commit this file. The repo's .gitignore should
# already ignore `supabase/functions/.env` (add it if yours does not).
#
# LOCAL TESTING
#   Supabase loads secrets for local dev from supabase/functions/.env.
#   Copy this template there and fill in real keys:
#     copy supabase\functions\analyze-meal\.env.example supabase\functions\.env
#
# PRODUCTION
#   Set the same names as Supabase secrets (no SUPABASE_ prefix allowed):
#     supabase secrets set GEMINI_API_KEY=... USDA_FDC_API_KEY=...
#   or push this file once filled in:
#     supabase secrets set --env-file supabase\functions\analyze-meal\.env
#
# GEMINI_API_KEY      — Google AI Studio key: https://aistudio.google.com/app/apikey
# USDA_FDC_API_KEY    — USDA FoodData Central key: https://api.data.gov/signup/

GEMINI_API_KEY=
USDA_FDC_API_KEY=

# Optional: Gemini model overrides. Default primary is gemini-3.6-flash.
# Do NOT use gemini-2.0-flash — Google has shut it down.
# The free tier caps some models at 20 requests per DAY, so when the primary is
# exhausted the function automatically tries the fallbacks below (each model has
# its own quota bucket). Provide a comma-separated list to override.
#GEMINI_MODEL=gemini-3.6-flash
#GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.1-flash-lite

# Browser origins allowed to call the analyze-meal function (comma-separated).
# Native (Expo Go / device) requests send no Origin and are unaffected. Leave
# unset for local Expo web (http://localhost:8081 and :19006 are the defaults);
# in production set the deployed web build's origin(s), e.g.
#   supabase secrets set ALLOWED_ORIGINS=https://snap-plate.example.com
#ALLOWED_ORIGINS=https://snap-plate.example.com

# The shared rate limiter uses the platform-injected SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY (or SUPABASE_SECRET_KEYS) automatically - they do
# not need to be set here. Without them the function falls back to the
# per-instance in-memory limiter, which is fine for local `deno run`.
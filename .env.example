# ─── SnapPlate environment ────────────────────────────────────────────────
# Copy this file to `.env` and fill in your values, then restart Expo:
#   cp .env.example .env        (Windows: copy .env.example .env)

# Supabase client configuration (Project Settings > API).
# These values are public-safe and are embedded in the app by Expo.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Backend endpoint (Supabase Edge Function).
# The app POSTs JSON: { "image_base64": "...", "mime_type": "image/jpeg" }
# and expects { "result": { ...NutritionResult } } back.
#
# Leave this EMPTY for local development: src/services/ai.ts auto-detects the
# analyze-meal server from the Metro dev-server host, so the app works on Wi-Fi,
# phone hotspots, emulators and the web build without editing this file.
# Set it to override, e.g. once deployed:
#   EXPO_PUBLIC_API_URL=https://<project-ref>.supabase.co/functions/v1/analyze-meal
EXPO_PUBLIC_API_URL=

# Empty + no discoverable dev-server host (a production build) = Demo mode.
# Nutrition values are computed by the backend via USDA FoodData Central; the
# Gemini and USDA API keys live in Supabase secrets — never in this file (see
# supabase/functions/analyze-meal/.env.example).